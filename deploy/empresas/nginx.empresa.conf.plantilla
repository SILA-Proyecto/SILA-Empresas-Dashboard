# Servidor web del dashboard de UNA empresa de SILA Empresas: {{ESQUEMA}} ({{NOMBRE}}).
# No se escribe a mano: `node scripts/nginx-empresa.mjs <ESQUEMA> --dominio <dominio>` rellena esta plantilla desde el
# registro de empresas del backend. (Para Llanolat se usa deploy/nginx.conf, que no se toca.)
#
# TODAS las empresas sirven el MISMO directorio estático (un solo `ng build` para todas): lo propio de cada una (nombre,
# módulos) lo da su backend en /empresa. Lo único que cambia por empresa es el subdominio y el puerto de su backend.
# Mismo origen para página y API: la cookie de renovación y la comprobación de origen del backend lo exigen.
#
# El backend de esta empresa debe correr con SILA_COOKIE_SECURE=true (HTTPS) y con https://{{SUBDOMINIO}}.{{DOMINIO}}
# como único origen permitido (CORS y anti-CSRF). Cada subdominio es un host distinto, así que la cookie `sila_refresh`
# de una empresa nunca llega a otra.

server {
  listen 80;
  server_name {{SUBDOMINIO}}.{{DOMINIO}};
  return 301 https://$host$request_uri;
}

server {
  listen 443 ssl;
  http2 on;
  server_name {{SUBDOMINIO}}.{{DOMINIO}};
  # Un certificado comodín (*.{{DOMINIO}}) sirve para todas las empresas; si no, uno por subdominio.
  ssl_certificate     /etc/letsencrypt/live/{{DOMINIO}}/fullchain.pem;     # TODO: ajusta la ruta
  ssl_certificate_key /etc/letsencrypt/live/{{DOMINIO}}/privkey.pem;       # TODO: ajusta la ruta

  root /var/www/sila;                            # el MISMO build para todas las empresas
  index index.html;
  server_tokens off;
  client_max_body_size 12m;                      # archivos del ADMIN: hasta 10 MB
  access_log /var/log/nginx/sila-{{SUBDOMINIO}}.access.log;
  error_log  /var/log/nginx/sila-{{SUBDOMINIO}}.error.log;

  gzip on;
  gzip_types text/css application/javascript application/json image/svg+xml;

  # El backend DE ESTA EMPRESA ({{ESQUEMA}}). Equivocar este puerto mezcla empresas: ver ESTADO_EMPRESAS.md.
  location /api/ {
    proxy_pass http://127.0.0.1:{{PUERTO_BACKEND}};
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 60s;
  }

{{BLOQUE_ENTORNO}}
  # Archivos con hash en el nombre: nunca cambian.
  location ~* \.(?:js|css|woff2|svg|ico)$ {
    include /etc/nginx/sila/cabeceras-seguridad.conf;
    add_header Cache-Control "public, max-age=31536000, immutable" always;
    try_files $uri =404;
  }

  # index.html nunca queda en caché (apunta a los archivos con hash de la versión vigente).
  location = /index.html {
    include /etc/nginx/sila/cabeceras-seguridad.conf;
    add_header Cache-Control "no-store" always;
  }

  # Rutas de la aplicación (SPA).
  location / {
    include /etc/nginx/sila/cabeceras-seguridad.conf;
    add_header Cache-Control "no-store" always;
    try_files $uri /index.html;
  }
}
